root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,shader,hlsl,asmdef}]
end_of_line = unset

[unity/**.{unity,prefab,asset,mat,anim,controller,meta}]
insert_final_newline = unset
trim_trailing_whitespace = unset
end_of_line = unset
indent_size = unset
