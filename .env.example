# Configuración de Sonia. Copiar a .env (ignorado por git) y rellenar las claves.
# Una variable vacía equivale a no ponerla: se usa el valor por defecto.

# --- Clave de OpenAI ---
# Con OPENAI_API_KEY basta: la usan GPT-Live, el modelo de visión y el de los gestos
# (este puede ir por Gemini con GEMINI_API_KEY: ver «Gestos al hablar»).
# LIVE_API_KEY y LLM_API_KEY la sustituyen si cada uno necesita la suya.
OPENAI_API_KEY=

# --- GPT-Live: voz y conversación (ADR 007) ---
LIVE_API_KEY=                 # opcional; vacío = OPENAI_API_KEY
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin              # marin, cedar, coral, sage, shimmer, ballad...; prueba con `sonia say`
LIVE_SAMPLE_RATE=24000        # 24000 o 16000 (micrófono y voz); 16000 si el micro no abre a 24 kHz
LIVE_BACKEND_MODEL=gpt-6-luna # modelo de la API Responses que ejecuta las acciones delegadas
LIVE_BACKEND_REASONING_EFFORT=low
LIVE_BACKEND_SERVICE_TIER=    # vacío = por defecto; priority = más rápido y más caro
LIVE_BACKEND_MAX_OUTPUT_TOKENS=2000   # razonamiento y búsquedas incluidos; con 400 se cortaban las búsquedas
# Búsqueda en internet del backend (web_search de la API Responses; docs/agenda.md).
LIVE_BACKEND_WEB_SEARCH=true
LIVE_BACKEND_WEB_SEARCH_CONTEXT=low   # low (rápido), medium o high
LIVE_BACKEND_WEB_SEARCH_COUNTRY=DO
LIVE_BACKEND_WEB_SEARCH_CITY=Santo Domingo
LIVE_SEGMENT_GAP_MS=800       # silencio en la voz de Sonia que cierra una frase hacia Unity

# --- Qué oye GPT-Live: la puerta del micro (MicGate, sonia/live/audio.py) ---
# Todas estas medidas deciden juntas en cada bloque del micro: micro silenciado
# desde el panel, frase grabada sonando, nadie delante de la cámara, silencio y
# puerta de ruido. Lo que no pasa le llega a GPT-Live como un ruido muy suave.
# Cada una se apaga sola con el valor que se indica. GPT-Live ya ignora solo las
# voces del pasillo (probado, docs/stand.md "Voces del pasillo"): la puerta de
# ruido y la cámara vienen apagadas.
#
# Puerta de ruido (0..1): por debajo de este nivel GPT-Live no oye el micrófono,
# para que no conteste a las voces del pasillo. 0 = apagada. Se
# calibra en el stand con el nivel que deja cada turno en el log
# ("Usuario (nivel 0.031)") o con el medidor del panel, que también la ajusta.
LIVE_GATE_RMS=0
# Cámara: OpenCV mira si hay alguien cerca (en este equipo, sin guardar nada).
# Sin ninguna cara cerca ni conversación en LIVE_PRESENCE_HOLD_SECONDS, GPT-Live
# deja de oír el micro hasta que llega alguien. No cuenta hasta que la cámara ve
# su primera cara ni si deja de dar imagen. Solo con VISION_SOURCE=opencv y el
# modelo YuNet del reconocimiento de caras. Cómo arranca: el interruptor del
# panel "Oír solo con alguien delante" la enciende y apaga en caliente y manda.
LIVE_PRESENCE_GATE=false
LIVE_PRESENCE_HOLD_SECONDS=600        # 10 minutos: muy generoso a propósito
LIVE_PRESENCE_SCAN_SECONDS=0.5        # cada cuánto mira la cámara (con sesión abierta)
LIVE_PRESENCE_MIN_FACE_PX=38          # cara mínima en una foto de 640 px (~1,8 m): el pasillo no cuenta
# Con alguien delante ahora mismo, la puerta de ruido se abre con este tanto de
# LIVE_GATE_RMS (quien habla bajito también pasa). 1 = apagado.
LIVE_PRESENCE_NEAR_GATE_SCALE=0.5
# Lo que oye GPT-Live cuando no oye el micro: un ruido muy suave. 0 = silencio
# absoluto, con el que se retrasaba mucho al contestar.
LIVE_COMFORT_NOISE_RMS=0.003

# --- Ojos: modelo con visión que describe la cámara ---
# GPT-Live no acepta imágenes. Vale cualquier modelo compatible con la API de
# OpenAI (/v1/chat/completions con image_url); por defecto, la propia OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=                  # opcional; vacío = OPENAI_API_KEY (o LIVE_API_KEY). Con otro proveedor, su clave (nunca la de OpenAI)
LLM_MAX_TOKENS_PARAM=max_completion_tokens  # max_tokens para servidores que no sean OpenAI
LLM_SUPPORTS_VISION=true      # false apaga la cámara entera y la acción `look`
LLM_REASONING_EFFORT=none     # en OpenAI: none | low (el doble de lento) | medium (defecto del modelo, lento) | high...; off = no enviarlo
LLM_IMAGE_DETAIL=low          # low | high | auto (OpenAI); off = no enviar `detail`
# LLM_EXTRA_BODY: campos extra del cuerpo en JSON, entre comillas simples (también se carga con `source`).
# Alternativa con Kimi K2.6 (K3 razona siempre y tarda decenas de segundos): descomenta y pon la clave de Moonshot.
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2.6
# LLM_API_KEY=
# LLM_REASONING_EFFORT=off
# LLM_IMAGE_DETAIL=off
# LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# --- Gestos al hablar: el director de gestos (docs/gestos.md) ---
# Un modelo de texto ligero lee lo que va diciendo Sonia y elige el gesto de cada
# frase del catálogo que manda Unity. Gasta poco: ver «Coste» en docs/gestos.md.
# `sonia check` lo prueba con una petición mínima (línea «Gestos»).
GESTURES_ENABLED=true         # false: Sonia habla sin gestos elegidos por el modelo
#
# Por defecto, con GEMINI_API_KEY puesta, va por Gemini (gemini-3.1-flash-lite,
# el que usa Genies para sus prompts auxiliares) por su endpoint compatible con
# OpenAI: ~1 s por petición. Manda reasoning_effort minimal (los Gemini 3 no
# dejan apagar el razonamiento), max_tokens y 512 de tope.
# GEMINI_API_KEY=
#
# Sin GEMINI_API_KEY (o con GESTURE_MODEL o GESTURE_BASE_URL puestos): el modelo
# de los ojos (LLM_*), gpt-6-luna con reasoning_effort none. Funciona, pero tarda
# ~4 s por petición: muchas frases acaban con gesto de relleno.
#
# Para cualquier otro servidor compatible con OpenAI: GESTURE_BASE_URL,
# GESTURE_MODEL y GESTURE_API_KEY (vacías = las de LLM_*).
# Ajustes finos (vacíos = lo que toca para cada servidor, docs/gestos.md):
# GESTURE_REASONING_EFFORT=   # none (OpenAI), minimal (Gemini 3)...; off = no enviarlo
# GESTURE_MAX_TOKENS=         # 64 sin razonar, 512 si razona (lo que razona cuenta en el tope)
# GESTURE_MAX_TOKENS_PARAM=   # max_tokens | max_completion_tokens
# GESTURE_EXTRA_BODY=         # campos extra del cuerpo en JSON, entre comillas simples
GESTURE_TIMEOUT_S=3           # tope de cada petición
GESTURE_MAX_DELAY_S=2.5       # un gesto que llegaría más tarde desde que empezó su frase se tira
GESTURE_MIN_GAP_S=0.5         # margen tras el núcleo del gesto anterior
GESTURE_REPEAT_S=90           # el mismo gesto no se repite antes
GESTURE_UNCOMMON_S=45         # como mucho un gesto Uncommon cada tanto
GESTURE_RARE_S=300            # y uno Rare cada tanto
GESTURE_FALLBACK=true         # si el modelo falla o no llega, un gesto de relleno neutro

# --- Cámara ---
VISION_SOURCE=opencv          # opencv | unity | obs | screen | none (obs y screen: modo reunión, docs/reunion.md)
VISION_CAMERA_INDEX=0
VISION_CAPTURE_WIDTH=1920     # resolución que se pide a la cámara USB si abre por debajo (en Windows
VISION_CAPTURE_HEIGHT=1080    # muchas abren a 640x480); las caras se buscan a esa resolución; 0 = la suya
# Modo reunión (`sonia reunion` pone VISION_SOURCE=obs): Sonia ve la fuente de OBS
# con la ventana de la videollamada. La contraseña se lee de la configuración de OBS.
VISION_OBS_URL=ws://127.0.0.1:4455
VISION_OBS_PASSWORD=
VISION_OBS_SOURCE=Reunión
VISION_SCREEN_MONITOR=1       # con VISION_SOURCE=screen: 1 = pantalla principal, 2 = la segunda…
VISION_ON_TURN_START=false    # true: describir la cámara cuando alguien empieza a hablar (por defecto solo mira con look)
VISION_INTERVAL_SECONDS=0     # además, cada N segundos con alguien delante (0 = nunca)
VISION_DEBUG_SAVE_FRAMES=false  # nunca en el stand: guarda capturas en disco

# --- Caras conocidas: el equipo de Sonnet Code y los ponentes (docs/caras.md) ---
# En este equipo, con OpenCV; de los visitantes no se guarda nada. Preparar: sonia caras.
FACES_ENABLED=true
FACES_MODEL=arcface           # arcface (ArcFace R50, 174 MB: el doble de aciertos de lado, lejos y a oscuras) | sface
FACES_ARCFACE_THRESHOLD=0.40  # similitud mínima con ArcFace; calibrar en el stand con sonia caras --probar
FACES_THRESHOLD=0.52          # similitud mínima con SFace (FACES_MODEL=sface)
FACES_MARGIN=0.06             # ventaja mínima sobre la segunda persona más parecida
FACES_MIN_FACE_PX=40          # cara más pequeña que cuenta, en la foto de la cámara: unos 4 m a 1920 px
FACES_ANALYSIS_WIDTH=1920     # ancho máximo de la foto en la que se buscan caras (0 = la de la cámara)
FACES_SCAN_SECONDS=1          # cada cuánto mira sola con sesión abierta (0 = solo cuando Sonia usa la cámara)
FACES_CONFIRM_SCANS=2         # revisiones en que tiene que salir (seguidas o no) antes de avisar a Sonia...
FACES_CONFIRM_SECONDS=4       # ...dentro de estos segundos
FACES_COOLDOWN_MINUTES=20     # sin repetir el aviso de la misma persona, salvo que Sonia use la cámara
FACES_SPEAKERS=true           # también los ponentes de la agenda
FACES_STAFF_FILE=             # vacío = assets/faces/staff.json
FACES_GUESTS_FILE=            # vacío = assets/faces/invitados.json (personas conocidas, no del equipo ni ponentes)
FACES_GREETINGS_FILE=         # vacío = assets/faces/saludos.json (cómo saludar la primera vez, por persona y por grupo)
FACES_DIR=                    # vacío = cache/faces (modelos, huellas y fotos locales)

# --- Micrófono ---
AUDIO_INPUT_DEVICE=           # índice o nombre de sounddevice; vacío = por defecto. Si no está en el
                              # equipo, se usa el del sistema. Lo elegido en el menú de opciones de Unity
                              # (Esc > Micrófono, cámara y pantalla) se guarda en DEVICES_FILE y manda.
AUDIO_BLOCK_MS=32             # tamaño de cada bloque del micrófono hacia GPT-Live

# --- WebSocket hacia Unity ---
WS_HOST=127.0.0.1
WS_PORT=8765

# --- Panel de control web (docs/panel.md) ---
PANEL_ENABLED=true
PANEL_PORT=8780               # panel local de respaldo: http://127.0.0.1:8780
# Panel en Cloudflare (https://sonia.sonnetcode.com): esta Sonia se conecta
# hacia fuera. Sin token no se conecta y solo queda el panel local.
PANEL_CLOUD_URL=wss://sonia.sonnetcode.com/agent
PANEL_CLOUD_TOKEN=            # el AGENT_TOKEN del Worker sonia-panel (secreto)
PANEL_INSTANCE_NAME=          # cómo sale en el panel; vacío = nombre del equipo
PANEL_GREETER_INTERVAL_MIN_SECONDS=25   # modo "Solo saludos": cada cuánto saluda
PANEL_GREETER_INTERVAL_MAX_SECONDS=55
# Solo si se llega al panel LOCAL a través de Cloudflare Access (no es lo normal):
PANEL_ACCESS_TEAM_DOMAIN=
PANEL_ACCESS_AUD=

# --- Animación de stand (frases, bailes y momentos cuando no hay nadie) ---
SHOWCASE_ENABLED=true
SHOWCASE_FIRST_DELAY_SECONDS=25
SHOWCASE_INTERVAL_MIN_SECONDS=40
SHOWCASE_INTERVAL_MAX_SECONDS=90
SHOWCASE_DANCE_CHANCE=0.3
# De lo que no es baile, qué parte son momentos: una invitación a acercarse que
# GPT-Live improvisa con lo que pasa ahora (por turnos: la charla que toca, lo
# que ve la cámara y algo que se puede probar). 0 = solo las frases fijas.
SHOWCASE_MOMENT_CHANCE=0.6
SHOWCASE_MOMENT_CAMERA=true   # false = los momentos no miran la cámara (sin foto ni modelo de visión)

# --- Trivia (docs/trivia.md): preguntas en assets/trivia/preguntas.md ---
TRIVIA_ENABLED=true
TRIVIA_QUESTIONS=5
TRIVIA_WIN_THRESHOLD=3
# Sin respuesta registrada durante esto, se le recuerda a Sonia una vez (que registre
# la que ya dijo el visitante o que le anime); sin oír al visitante durante
# TRIVIA_ABANDON_SECONDS, la partida se cancela.
TRIVIA_REMIND_SECONDS=25
TRIVIA_ABANDON_SECONDS=60
# Tras la última respuesta, segundos mínimos antes de la pantalla final (la
# siguiente pregunta solo sale cuando el visitante la pide).
TRIVIA_REVEAL_SECONDS=4
# Con quién del stand manda Sonia a hablar a quien gana (vacío = a nadie). Sonia no
# sabe qué premios hay: los da el equipo.
TRIVIA_WIN_CONTACT=Brian o Mariel

# --- Juegos del stand (docs/juegos.md): uno a la vez, nunca con la trivia ---
# Un juego se ofrece si está encendido aquí, en su bloque y en games/registry.py, no
# está apagado desde el panel y la pantalla (Unity) lo anuncia.
GAMES_ENABLED=true
GAMES_ABANDON_SECONDS=60      # sin voz ni actividad, la partida se cancela (cada juego puede tener el suyo)
GAMES_NUDGE_SECONDS=3         # el visitante habló y no se delegó nada: se le recuerda a Sonia (los juegos que lo piden)
GAMES_RESULT_SECONDS=4        # al terminar, el resultado se queda al menos esto en pantalla...
GAMES_FINAL_WAIT_SECONDS=20   # ...y como mucho esto esperando a que Sonia termine de contarlo
# Modelos de poses y manos (como los de caras); vacío = cache/games/modelos.
GAMES_MODELS_DIR=

# La ruleta de Sonnia (docs/juegos/ruleta.md)
GAME_RULETA_ENABLED=true
GAME_RULETA_WEIGHTS=1,1,1,1,1   # trivia relámpago, adivinanza, explica en 20 s, futuro de la IA, reto de Sonnet Code
GAME_RULETA_QUIZ_SECONDS=20
GAME_RULETA_HINT_SECONDS=30
GAME_RULETA_EXPLAIN_SECONDS=20
GAME_RULETA_ABANDON_SECONDS=60

# Simón dice con poses (docs/juegos/poses.md)
GAME_POSES_ENABLED=true
GAME_POSES_ROUNDS=6
GAME_POSES_TRICKS=1             # rondas trampa (sin «Simón dice»), nunca la primera
GAME_POSES_WINDOW_SECONDS=1.8
GAME_POSES_MIN_PERSON=0.25      # altura mínima de un jugador en la imagen (fracción)
GAME_POSES_FPS=8
GAME_POSES_MODEL=n              # n (ligero, por defecto) o s (más preciso, el doble de CPU)
GAME_POSES_ABANDON_SECONDS=0    # 0 = GAMES_ABANDON_SECONDS

# Akinator dev (docs/juegos/akinator.md)
GAME_AKINATOR_ENABLED=true
GAME_AKINATOR_MAX_QUESTIONS=20
GAME_AKINATOR_MIN_QUESTIONS=5   # no intenta adivinar antes de esta pregunta
GAME_AKINATOR_ABANDON_SECONDS=60

# Piedra, papel o tijera (docs/juegos/piedra_papel_tijera.md)
GAME_PPT_ENABLED=true
GAME_PPT_ROUNDS=3               # al mejor de tres
GAME_PPT_READ_SECONDS=0.8
GAME_PPT_FPS=8
GAME_PPT_RETRIES=1              # veces que se repite una ronda si no se ve la mano
GAME_PPT_ABANDON_SECONDS=0      # 0 = GAMES_ABANDON_SECONDS

# Wordle de tecnología (docs/juegos/wordle.md)
GAME_WORDLE_ENABLED=true
GAME_WORDLE_ROWS=6              # intentos (entre 3 y 8)
GAME_WORDLE_HINT_AFTER=4        # la pista sale tras estos intentos fallidos (0 = sin pista)
GAME_WORDLE_ABANDON_SECONDS=90  # sin voz ni actividad del grupo, la partida se cancela

# Búsqueda relámpago (docs/juegos/busqueda.md)
GAME_BUSQUEDA_ENABLED=true
GAME_BUSQUEDA_ROUNDS=3
GAME_BUSQUEDA_ROUND_SECONDS=25
GAME_BUSQUEDA_CHECK_SECONDS=2.5
GAME_BUSQUEDA_MAX_CHECKS=10     # tope de fotos al modelo de visión por ronda
GAME_BUSQUEDA_ABANDON_SECONDS=0 # 0 = GAMES_ABANDON_SECONDS

# --- Agenda del DevFest en vivo (docs/agenda.md) ---
AGENDA_URL=https://devfest.gdgsantodomingo.org/schedule   # off = solo la caché y la copia de la app
AGENDA_REFRESH_MINUTES=10     # cada cuánto mira si cambió (0 = solo al arrancar y cuando Sonia la consulta)
AGENDA_NOTICE_MINUTES=5       # le pasa a Sonia la hora y lo que empieza estos minutos antes de cada charla (0 = nunca)
AGENDA_TIMEOUT_SECONDS=6
AGENDA_CACHE_FILE=            # vacío = cache/agenda.json

# --- General ---
TIMEZONE=America/Santo_Domingo   # la hora que sabe y dice Sonia (la del stand, no la del equipo)
IDLE_RESET_SECONDS=120        # sin nadie este tiempo, sesión nueva de GPT-Live (olvida lo hablado)
IMAGE_AUTO_HIDE_SECONDS=30    # retirar sola una imagen mostrada (0 = nunca)
GALLERY_WATCH_SECONDS=5       # mirar assets/gallery y avisar a GPT-Live de lo que se añade o quita (0 = no)
LOG_LEVEL=INFO
# Minutos de conversación en total (todas las veces que se abra) para las builds de
# prueba del equipo; después Sonia se queda en «Fuera» con un letrero. 0 = sin límite.
# Lo pone el build.env de las builds de prueba; el stand no lo lleva.
TRIAL_LIMIT_MINUTES=0
