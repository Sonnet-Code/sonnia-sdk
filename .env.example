# --- Modelo de lenguaje (cualquier servidor compatible con OpenAI) ---
# Local (llama.cpp / vLLM / Ollama):
LLM_BASE_URL=http://localhost:8000/v1
LLM_MODEL=kimi-k3
LLM_API_KEY=local
# Provisional mientras no hay servidor local (API de Kimi en la nube):
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k3
# LLM_API_KEY=sk-...
LLM_SUPPORTS_VISION=true
LLM_TOOL_MODE=native          # native | prompt | none
LLM_REASONING_EFFORT=low      # vacío para no enviarlo
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=             # vacío = no enviar (Kimi K3 solo admite 1)

# --- Reconocimiento de voz ---
STT_BACKEND=faster_whisper    # faster_whisper | mock
STT_MODEL=small
STT_DEVICE=auto
STT_LANGUAGE=es

# --- Síntesis de voz ---
TTS_BACKEND=omnivoice         # omnivoice | http | gemini | system | mock
TTS_BASE_URL=http://127.0.0.1:8880/v1
TTS_VOICE_INSTRUCT=female, young adult, warm, natural, latin american spanish accent
TTS_REF_AUDIO=                # ruta a un wav para clonar voz (opcional)
TTS_DEVICE=auto
TTS_NUM_STEP=16
# Voz del sistema (say / SAPI / espeak-ng), sin red y de bajo consumo, para ensayos:
TTS_SYSTEM_VOICE=             # vacío = mejor voz en español (macOS: Paulina o Mónica)
TTS_SYSTEM_RATE=0             # palabras por minuto; 0 = por defecto
# Provisional mientras no hay GPU (ADR 006): TTS_BACKEND=gemini
TTS_GEMINI_API_KEY=           # clave de Google AI Studio (free tier)
TTS_GEMINI_MODE=live          # live (WebSocket, streaming) | tts (REST, lectura literal)
TTS_GEMINI_VOICE=Leda         # voces femeninas: Leda, Kore, Aoede...
TTS_GEMINI_LANGUAGE=es-ES

# --- Audio de entrada ---
AUDIO_INPUT_DEVICE=           # índice o nombre de sounddevice; vacío = por defecto
AUDIO_VAD_THRESHOLD=0.5
AUDIO_END_SILENCE_MS=600
AUDIO_BARGE_IN=true
# Nivel RMS medio (0..1) que debe alcanzar la voz de un turno; por debajo se
# descarta como conversación de fondo. 0 lo desactiva. El log dice el nivel de
# cada turno ("Usuario (nivel 0.08)") para calibrarlo en el sitio.
AUDIO_MIN_TURN_RMS=0

# --- Visión ---
VISION_SOURCE=opencv          # opencv | unity | none
VISION_CAMERA_INDEX=0
VISION_ON_TURN_START=true
VISION_INTERVAL_SECONDS=0
VISION_DEBUG_SAVE_FRAMES=false

# --- WebSocket hacia Unity ---
WS_HOST=127.0.0.1
WS_PORT=8765

# --- Servidor MCP (mismas acciones que el modelo) ---
MCP_ENABLED=false
MCP_PORT=8766

LOG_LEVEL=INFO
