# Configuración de Sonia. Copiar a .env (ignorado por git) y rellenar las claves.
# Una variable vacía equivale a no ponerla: se usa el valor por defecto.

# --- Clave de OpenAI ---
# Con OPENAI_API_KEY basta: la usan GPT-Live, el modelo de visión y el de los gestos
# (este puede ir por Gemini con GEMINI_API_KEY: ver «Gestos al hablar»).
# LIVE_API_KEY y LLM_API_KEY la sustituyen si cada uno necesita la suya.
OPENAI_API_KEY=

# --- GPT-Live: voz y conversación (ADR 007) ---
LIVE_API_KEY=                 # opcional; vacío = OPENAI_API_KEY
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin              # marin, cedar, coral, sage, shimmer, ballad...; prueba con `sonia say`
LIVE_SAMPLE_RATE=24000        # 24000 o 16000 (micrófono y voz); 16000 si el micro no abre a 24 kHz
LIVE_BACKEND_MODEL=gpt-6-luna # modelo de la API Responses que ejecuta las acciones delegadas
LIVE_BACKEND_REASONING_EFFORT=low
LIVE_BACKEND_SERVICE_TIER=    # vacío = por defecto; priority = más rápido y más caro
LIVE_SEGMENT_GAP_MS=800       # silencio en la voz de Sonia que cierra una frase hacia Unity
# Puerta de ruido (0..1): por debajo de este nivel el micrófono manda silencio,
# para que GPT-Live no conteste a las voces del pasillo. 0 = apagada. Se
# calibra en el stand con el nivel que deja cada turno en el log
# ("Usuario (nivel 0.031)") o con el medidor del panel, que también la ajusta.
LIVE_GATE_RMS=0

# --- Ojos: modelo con visión que describe la cámara ---
# GPT-Live no acepta imágenes. Vale cualquier modelo compatible con la API de
# OpenAI (/v1/chat/completions con image_url); por defecto, la propia OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=                  # opcional; vacío = OPENAI_API_KEY (o LIVE_API_KEY). Con otro proveedor, su clave (nunca la de OpenAI)
LLM_MAX_TOKENS_PARAM=max_completion_tokens  # max_tokens para servidores que no sean OpenAI
LLM_SUPPORTS_VISION=true      # false apaga la cámara entera y la acción `look`
LLM_REASONING_EFFORT=low      # en OpenAI: none | low | medium (defecto del modelo, lento) | high...; off = no enviarlo
LLM_IMAGE_DETAIL=low          # low | high | auto (OpenAI); off = no enviar `detail`
# LLM_EXTRA_BODY: campos extra del cuerpo en JSON, entre comillas simples (también se carga con `source`).
# Alternativa con Kimi K2.6 (K3 razona siempre y tarda decenas de segundos): descomenta y pon la clave de Moonshot.
# LLM_BASE_URL=https://api.moonshot.ai/v1
# LLM_MODEL=kimi-k2.6
# LLM_API_KEY=
# LLM_REASONING_EFFORT=off
# LLM_IMAGE_DETAIL=off
# LLM_EXTRA_BODY='{"thinking":{"type":"disabled"}}'

# --- Gestos al hablar: el director de gestos (docs/gestos.md) ---
# Un modelo de texto ligero lee lo que va diciendo Sonia y elige el gesto de cada
# frase del catálogo que manda Unity. Gasta poco: ver «Coste» en docs/gestos.md.
# `sonia check` lo prueba con una petición mínima (línea «Gestos»).
GESTURES_ENABLED=true         # false: Sonia habla sin gestos elegidos por el modelo
#
# Opción A (por defecto, no hay que poner nada): el modelo de los ojos (LLM_*),
# gpt-6-luna en OpenAI con OPENAI_API_KEY y reasoning_effort none (sin razonar).
#
# Opción B: Gemini por su endpoint compatible con OpenAI (gemini-3.1-flash-lite
# es el que usa Genies para sus prompts auxiliares). Descomenta las tres líneas y
# pon la clave de Google AI Studio. Por defecto manda reasoning_effort minimal
# (los Gemini 3 no dejan apagar el razonamiento), max_tokens y 512 de tope.
# GESTURE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GESTURE_MODEL=gemini-3.1-flash-lite
# GEMINI_API_KEY=
#
# Para cualquier otro servidor compatible con OpenAI: GESTURE_BASE_URL,
# GESTURE_MODEL y GESTURE_API_KEY (vacías = las de LLM_*).
# Ajustes finos (vacíos = lo que toca para cada servidor, docs/gestos.md):
# GESTURE_REASONING_EFFORT=   # none (OpenAI), minimal (Gemini 3)...; off = no enviarlo
# GESTURE_MAX_TOKENS=         # 64 sin razonar, 512 si razona (lo que razona cuenta en el tope)
# GESTURE_MAX_TOKENS_PARAM=   # max_tokens | max_completion_tokens
# GESTURE_EXTRA_BODY=         # campos extra del cuerpo en JSON, entre comillas simples
GESTURE_TIMEOUT_S=3           # tope de cada petición
GESTURE_MAX_DELAY_S=2.5       # un gesto que llegaría más tarde desde que empezó su frase se tira
GESTURE_MIN_GAP_S=0.5         # margen tras el núcleo del gesto anterior
GESTURE_REPEAT_S=90           # el mismo gesto no se repite antes
GESTURE_UNCOMMON_S=45         # como mucho un gesto Uncommon cada tanto
GESTURE_RARE_S=300            # y uno Rare cada tanto
GESTURE_FALLBACK=true         # si el modelo falla o no llega, un gesto de relleno neutro

# --- Cámara ---
VISION_SOURCE=opencv          # opencv | unity | obs | screen | none (obs y screen: modo reunión, docs/reunion.md)
VISION_CAMERA_INDEX=0
# Modo reunión (`sonia reunion` pone VISION_SOURCE=obs): Sonia ve la fuente de OBS
# con la ventana de la videollamada. La contraseña se lee de la configuración de OBS.
VISION_OBS_URL=ws://127.0.0.1:4455
VISION_OBS_PASSWORD=
VISION_OBS_SOURCE=Reunión
VISION_SCREEN_MONITOR=1       # con VISION_SOURCE=screen: 1 = pantalla principal, 2 = la segunda…
VISION_ON_TURN_START=false    # true: describir la cámara cuando alguien empieza a hablar (por defecto solo mira con look)
VISION_INTERVAL_SECONDS=0     # además, cada N segundos con alguien delante (0 = nunca)
VISION_DEBUG_SAVE_FRAMES=false  # nunca en el stand: guarda capturas en disco

# --- Micrófono ---
AUDIO_INPUT_DEVICE=           # índice o nombre de sounddevice; vacío = por defecto
AUDIO_BLOCK_MS=32             # tamaño de cada bloque del micrófono hacia GPT-Live

# --- WebSocket hacia Unity ---
WS_HOST=127.0.0.1
WS_PORT=8765

# --- Panel de control web (docs/panel.md) ---
PANEL_ENABLED=true
PANEL_PORT=8780               # panel local de respaldo: http://127.0.0.1:8780
# Panel en Cloudflare (https://sonia.sonnetcode.com): esta Sonia se conecta
# hacia fuera. Sin token no se conecta y solo queda el panel local.
PANEL_CLOUD_URL=wss://sonia.sonnetcode.com/agent
PANEL_CLOUD_TOKEN=            # el AGENT_TOKEN del Worker sonia-panel (secreto)
PANEL_INSTANCE_NAME=          # cómo sale en el panel; vacío = nombre del equipo
PANEL_GREETER_INTERVAL_MIN_SECONDS=25   # modo "Solo saludos": cada cuánto saluda
PANEL_GREETER_INTERVAL_MAX_SECONDS=55
# Solo si se llega al panel LOCAL a través de Cloudflare Access (no es lo normal):
PANEL_ACCESS_TEAM_DOMAIN=
PANEL_ACCESS_AUD=

# --- Animación de stand (frases y bailes cuando no hay nadie) ---
SHOWCASE_ENABLED=true
SHOWCASE_FIRST_DELAY_SECONDS=25
SHOWCASE_INTERVAL_MIN_SECONDS=40
SHOWCASE_INTERVAL_MAX_SECONDS=90
SHOWCASE_DANCE_CHANCE=0.3

# --- Trivia (docs/trivia.md): preguntas en assets/trivia/preguntas.md ---
TRIVIA_ENABLED=true
TRIVIA_QUESTIONS=5
TRIVIA_WIN_THRESHOLD=3
# Sin respuesta registrada durante esto, se le recuerda a Sonia una vez (que registre
# la que ya dijo el visitante o que le anime); sin oír al visitante durante
# TRIVIA_ABANDON_SECONDS, la partida se cancela.
TRIVIA_REMIND_SECONDS=25
TRIVIA_ABANDON_SECONDS=60
# Tras la última respuesta, segundos mínimos antes de la pantalla final (la
# siguiente pregunta solo sale cuando el visitante la pide).
TRIVIA_REVEAL_SECONDS=4

# --- General ---
IDLE_RESET_SECONDS=120        # sin nadie este tiempo, sesión nueva de GPT-Live (olvida lo hablado)
IMAGE_AUTO_HIDE_SECONDS=30    # retirar sola una imagen mostrada (0 = nunca)
LOG_LEVEL=INFO
# Minutos de conversación en total (todas las veces que se abra) para las builds de
# prueba del equipo; después Sonia se queda en «Fuera» con un letrero. 0 = sin límite.
# Lo pone el build.env de las builds de prueba; el stand no lo lleva.
TRIAL_LIMIT_MINUTES=0
