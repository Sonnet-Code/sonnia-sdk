# Sonnia settings. Copy to .env (ignored by git) and fill in the keys.
# An empty variable is the same as not setting it: the default value is used.

# --- OpenAI key ---
# OPENAI_API_KEY is enough: GPT-Live and the vision model use it.
# LIVE_API_KEY and LLM_API_KEY replace it if each one needs its own.
OPENAI_API_KEY=

# --- GPT-Live: voice and conversation ---
LIVE_API_KEY=                 # optional; empty = OPENAI_API_KEY
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin              # marin, cedar, coral, sage, shimmer, ballad...; try them with `sonia say`
LIVE_SAMPLE_RATE=24000        # 24000 or 16000 (microphone and voice); 16000 if the microphone does not open at 24 kHz
LIVE_BACKEND_MODEL=gpt-6-luna # Responses API model that runs the delegated actions
LIVE_BACKEND_REASONING_EFFORT=low
LIVE_BACKEND_SERVICE_TIER=    # empty = default; priority = faster and more expensive
LIVE_BACKEND_MAX_OUTPUT_TOKENS=2000   # reasoning and searches included; with 400 web searches were cut short
LIVE_BACKEND_MAX_TOOL_ROUNDS=3        # rounds of actions per delegated task

# Web search of the backend (the Responses API web_search tool).
LIVE_BACKEND_WEB_SEARCH=true
LIVE_BACKEND_WEB_SEARCH_CONTEXT=low   # low (faster), medium or high
LIVE_BACKEND_WEB_SEARCH_COUNTRY=      # ISO country code for local results (e.g. US); empty = not sent
LIVE_BACKEND_WEB_SEARCH_CITY=         # city for local results; empty = not sent

LIVE_SEGMENT_GAP_MS=800       # silence in Sonnia's voice that closes an utterance for the avatar client
LIVE_USER_TURN_GAP_MS=1200    # silence in the user's transcript that closes their turn

# --- What GPT-Live hears: the microphone gate (MicGate, sonia/live/audio.py) ---
# These measures decide together on every microphone block: microphone muted from
# the panel, a recorded line playing, silence and the noise gate. Whatever does not
# get through reaches GPT-Live as a very soft noise. GPT-Live already ignores most
# background voices on its own, so the noise gate is off by default.
#
# Noise gate (0..1): below this level GPT-Live does not hear the microphone, so it
# does not answer background conversations. 0 = off. Calibrate it on site with the
# level each turn leaves in the log ("User (level 0.031)") or with the panel meter,
# which also adjusts it.
LIVE_GATE_RMS=0
LIVE_GATE_HOLD_MS=900         # how long the gate stays open after the last voice above the threshold
# What GPT-Live hears when it does not hear the microphone: a very soft noise.
# 0 = absolute silence, with which it answered much later.
LIVE_COMFORT_NOISE_RMS=0.003

# Session housekeeping.
LIVE_VISION_MIN_INTERVAL_SECONDS=10   # minimum time between two camera descriptions
LIVE_CONTEXT_RESTART_RATIO=0.85       # new session at the next quiet moment once the context is this full
LIVE_CONNECT_TIMEOUT=15
LIVE_RECONNECT_MIN_SECONDS=1
LIVE_RECONNECT_MAX_SECONDS=15

# --- Eyes: vision model that describes the camera ---
# GPT-Live does not accept images. Any OpenAI-compatible model works
# (/v1/chat/completions with image_url); OpenAI itself by default.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=                  # optional; empty = OPENAI_API_KEY (or LIVE_API_KEY). With another provider, its own key (never the OpenAI one)
LLM_MAX_TOKENS_PARAM=max_completion_tokens  # max_tokens for servers other than OpenAI
LLM_SUPPORTS_VISION=true      # false turns the whole camera and the `look` action off
LLM_REASONING_EFFORT=none     # on OpenAI: none | low | medium | high...; off = do not send it
LLM_IMAGE_DETAIL=low          # low | high | auto (OpenAI); off = do not send `detail`
LLM_MAX_TOKENS=400
LLM_REQUEST_TIMEOUT=60
# LLM_EXTRA_BODY: extra request body fields as JSON, in single quotes, for whatever a
# specific server needs (for example a flag that turns off a model's reasoning).
# LLM_EXTRA_BODY='{"some_server_option": true}'

# --- Camera ---
VISION_SOURCE=opencv          # opencv (USB camera from Python) | unity (the avatar client sends frames) | none
VISION_CAMERA_INDEX=0
VISION_CAPTURE_WIDTH=1920     # resolution requested from the USB camera if it opens below it (on Windows
VISION_CAPTURE_HEIGHT=1080    # many open at 640x480); 0 = whatever the camera gives
VISION_MAX_WIDTH=768          # snapshots are downscaled to this width before going to a model
VISION_JPEG_QUALITY=80
VISION_ON_TURN_START=false    # true: describe the camera when someone starts talking (by default she only looks with `look`)
VISION_INTERVAL_SECONDS=0     # also every N seconds (0 = never)
VISION_DEBUG_SAVE_FRAMES=false  # debugging only, never with real visitors: saves snapshots to disk
VISION_DEBUG_DIR=             # empty = debug_frames/

# --- Microphone ---
AUDIO_INPUT_DEVICE=           # sounddevice index or name; empty = default. If it is not on this
                              # machine, the system one is used. What is picked in the avatar client
                              # options menu is saved in DEVICES_FILE and wins.
AUDIO_BLOCK_MS=32             # size of each microphone block sent to GPT-Live
DEVICES_FILE=                 # empty = cache/devices.json

# --- WebSocket to the avatar client ---
WS_HOST=127.0.0.1
WS_PORT=8765

# --- Local web control panel ---
PANEL_ENABLED=true
PANEL_HOST=127.0.0.1          # the panel has no login: keep it on this machine
PANEL_PORT=8780               # http://127.0.0.1:8780
PANEL_STATE_FILE=             # empty = cache/panel_state.json
PANEL_VOICE_CACHE_DIR=        # empty = cache/voice (fixed lines recorded with the GPT-Live voice)
PANEL_GREETER_INTERVAL_MIN_SECONDS=25   # "Greeter" mode: how often she greets
PANEL_GREETER_INTERVAL_MAX_SECONDS=55
PANEL_LIVE_PRICE_PER_MINUTE=0.05        # GPT-Live price per session minute, to estimate the cost

# --- Idle animation (lines, dances and moments when nobody is around) ---
SHOWCASE_ENABLED=true
SHOWCASE_FIRST_DELAY_SECONDS=25
SHOWCASE_INTERVAL_MIN_SECONDS=40
SHOWCASE_INTERVAL_MAX_SECONDS=90
SHOWCASE_DANCE_CHANCE=0.3
SHOWCASE_GESTURE_CHANCE=0.5
# Of what is not a dance, the share of moments: an invitation to come closer that
# GPT-Live improvises from what is happening now (in turns: what the camera sees and
# something people can try). 0 = only the fixed lines.
SHOWCASE_MOMENT_CHANCE=0.6
SHOWCASE_MOMENT_CAMERA=true   # false = moments do not look through the camera (no photo, no vision model)

# --- Trivia: questions in assets/trivia/questions.md ---
TRIVIA_ENABLED=true
TRIVIA_QUESTIONS=5
TRIVIA_WIN_THRESHOLD=3
TRIVIA_DEFAULT_LEVEL=medium   # easy | medium | hard, when the player does not choose
# With no answer recorded for this long, Sonnia is reminded once (to record the one
# the player already gave or to encourage them); without hearing the player for
# TRIVIA_ABANDON_SECONDS, the game is cancelled.
TRIVIA_REMIND_SECONDS=25
TRIVIA_ABANDON_SECONDS=60
# After the last answer, minimum seconds before the final screen (the next question
# only comes when the player asks for it).
TRIVIA_REVEAL_SECONDS=4
TRIVIA_FINAL_WAIT_SECONDS=20
# Who Sonnia sends winners to (for example "the people at the front desk"); empty =
# nobody. Sonnia does not know about prizes and never promises any.
TRIVIA_WIN_CONTACT=

# --- General ---
TIMEZONE=                     # IANA zone of the date and time Sonnia knows (e.g. Europe/Madrid); empty = the system one
IDLE_RESET_SECONDS=120        # without anyone for this long, a new GPT-Live session (forgets what was said)
IMAGE_AUTO_HIDE_SECONDS=30    # hide a shown image on its own (0 = never)
GALLERY_WATCH_SECONDS=5       # check assets/gallery and tell GPT-Live what is added or removed (0 = no)
GALLERY_UPLOAD_DIR=           # empty = cache/gallery: the images uploaded from the panel
KNOWLEDGE_EXTRA_DIR=          # another knowledge folder read after assets/knowledge (e.g. test data)
LOG_LEVEL=INFO
# Environment only (not read from this file):
# SONIA_HOME: root of cache/ and overrides.env (unset = the repository).
# SONIA_PARENT_PID: set by the avatar app when it launches the orchestrator; if that
# app dies, the orchestrator exits. Leave it unset when you launch it by hand.
