# Configuración de Sonia. Copiar a .env (ignorado por git) y rellenar las claves.
# Una variable vacía equivale a no ponerla: se usa el valor por defecto.

# --- Clave de OpenAI ---
# Con OPENAI_API_KEY basta: la usan GPT-Live y el modelo de visión.
# LIVE_API_KEY y LLM_API_KEY la sustituyen si cada uno necesita la suya.
OPENAI_API_KEY=

# --- GPT-Live: voz y conversación (ADR 007) ---
LIVE_API_KEY=                 # opcional; vacío = OPENAI_API_KEY
LIVE_MODEL=gpt-live-1
LIVE_VOICE=marin              # marin, cedar, coral, sage, shimmer, ballad...; prueba con `sonia say`
LIVE_SAMPLE_RATE=24000        # 24000 o 16000 (micrófono y voz); 16000 si el micro no abre a 24 kHz
LIVE_BACKEND_MODEL=gpt-6-luna # modelo de la API Responses que ejecuta las acciones delegadas
LIVE_BACKEND_REASONING_EFFORT=low
LIVE_BACKEND_SERVICE_TIER=    # vacío = por defecto; priority = más rápido y más caro
LIVE_SEGMENT_GAP_MS=800       # silencio en la voz de Sonia que cierra una frase hacia Unity
# Puerta de ruido (0..1): por debajo de este nivel el micrófono manda silencio,
# para que GPT-Live no conteste a las voces del pasillo. 0 = apagada. Se
# calibra en el stand con el nivel que deja cada turno en el log
# ("Usuario (nivel 0.031)") o con el medidor del panel, que también la ajusta.
LIVE_GATE_RMS=0

# --- Ojos: modelo con visión que describe la cámara ---
# GPT-Live no acepta imágenes. Vale cualquier modelo compatible con la API de
# OpenAI (/v1/chat/completions con image_url); por defecto, la propia OpenAI.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-luna
LLM_API_KEY=                  # opcional; vacío = OPENAI_API_KEY
LLM_MAX_TOKENS_PARAM=max_completion_tokens  # max_tokens para servidores que no sean OpenAI
LLM_SUPPORTS_VISION=true      # false apaga la cámara entera y la acción `look`

# --- Cámara ---
VISION_SOURCE=opencv          # opencv | unity | none
VISION_CAMERA_INDEX=0
VISION_ON_TURN_START=true     # describir la cámara cuando alguien empieza a hablar
VISION_INTERVAL_SECONDS=0     # además, cada N segundos con alguien delante (0 = nunca)
VISION_DEBUG_SAVE_FRAMES=false  # nunca en el stand: guarda capturas en disco

# --- Micrófono ---
AUDIO_INPUT_DEVICE=           # índice o nombre de sounddevice; vacío = por defecto
AUDIO_BLOCK_MS=32             # tamaño de cada bloque del micrófono hacia GPT-Live

# --- WebSocket hacia Unity ---
WS_HOST=127.0.0.1
WS_PORT=8765

# --- Panel de control web (docs/panel.md) ---
PANEL_ENABLED=true
PANEL_PORT=8780               # panel local de respaldo: http://127.0.0.1:8780
# Panel en Cloudflare (https://sonia.sonnetcode.com): esta Sonia se conecta
# hacia fuera. Sin token no se conecta y solo queda el panel local.
PANEL_CLOUD_URL=wss://sonia.sonnetcode.com/agent
PANEL_CLOUD_TOKEN=            # el AGENT_TOKEN del Worker sonia-panel (secreto)
PANEL_INSTANCE_NAME=          # cómo sale en el panel; vacío = nombre del equipo
PANEL_GREETER_INTERVAL_MIN_SECONDS=25   # modo "Solo saludos": cada cuánto saluda
PANEL_GREETER_INTERVAL_MAX_SECONDS=55
# Solo si se llega al panel LOCAL a través de Cloudflare Access (no es lo normal):
PANEL_ACCESS_TEAM_DOMAIN=
PANEL_ACCESS_AUD=

# --- Animación de stand (frases y bailes cuando no hay nadie) ---
SHOWCASE_ENABLED=true
SHOWCASE_FIRST_DELAY_SECONDS=25
SHOWCASE_INTERVAL_MIN_SECONDS=40
SHOWCASE_INTERVAL_MAX_SECONDS=90
SHOWCASE_DANCE_CHANCE=0.3

# --- General ---
IDLE_RESET_SECONDS=120        # sin nadie este tiempo, sesión nueva de GPT-Live (olvida lo hablado)
IMAGE_AUTO_HIDE_SECONDS=30    # retirar sola una imagen mostrada (0 = nunca)
LOG_LEVEL=INFO
