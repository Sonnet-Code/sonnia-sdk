{
  "name": "sonia-panel",
  "version": "1.0.0",
  "private": true,
  "description": "Panel de control de Sonia en Cloudflare (Worker + Durable Object).",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npm run build && wrangler dev",
    "types": "wrangler types --include-env=false",
    "typecheck": "wrangler types --include-env=false && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
