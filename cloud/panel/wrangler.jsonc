// Panel de control de Sonia en Cloudflare: https://sonia.sonnetcode.com
// (https://sonnia.sonnetcode.com, con doble n como se escribe Sonnia, redirige ahí).
// Sin account_id: se toma de la sesión de wrangler de quien despliega.
// Secretos (wrangler secret put): AGENT_TOKEN, PANEL_PASSWORD y, cuando
// exista la aplicación de Cloudflare Access, ACCESS_TEAM_DOMAIN y ACCESS_AUD.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sonia-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // Solo el dominio propio: ni *.workers.dev ni URLs de vista previa, que
  // quedarían fuera de la aplicación de Cloudflare Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sonia.sonnetcode.com", "custom_domain": true },
    { "pattern": "sonnia.sonnetcode.com", "custom_domain": true }
  ],

  // Estáticos (página del panel y galería) que copia scripts/build.mjs.
  // run_worker_first: todo pasa antes por el Worker, que exige la sesión.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Un único Durable Object ("control") con el estado de todas las Sonias y,
  // aparte, una sala del Modo Jean por Sonia (solo reenvía media; no guarda nada).
  // El plan free de Workers solo admite Durable Objects con SQLite.
  "durable_objects": {
    "bindings": [
      { "name": "CONTROL_ROOM", "class_name": "ControlRoom" },
      { "name": "GUEST_ROOM", "class_name": "GuestRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ControlRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["GuestRoom"] }
  ],

  // Registros muestreados: los mensajes de estado de las Sonias llegan cada
  // 0,5 s mientras alguien mira y agotarían la cuota gratuita de logs.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
